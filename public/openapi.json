{
  "openapi": "3.1.0",
  "info": {
    "title": "Amer Kallajo Human API resources",
    "version": "0.1.0",
    "description": "A static, read-only map of public Human API files. Capability routes in the profile are semantic routing labels, not executable HTTP operations.",
    "contact": {
      "name": "Amer Kallajo",
      "email": "Amerkallajoo@gmail.com"
    }
  },
  "servers": [{ "url": "/" }],
  "paths": {
    "/human-api.json": {
      "get": {
        "summary": "Get the canonical evidence-led routing profile",
        "responses": {
          "200": {
            "description": "Human API profile",
            "content": {
              "application/json": {
                "schema": { "$ref": "/human-api.schema.json" }
              }
            }
          }
        }
      }
    },
    "/human-api.schema.json": {
      "get": {
        "summary": "Get the JSON Schema for Human API v0.1",
        "responses": { "200": { "description": "JSON Schema document" } }
      }
    },
    "/evidence.json": {
      "get": {
        "summary": "Get the evidence and provenance ledger",
        "responses": { "200": { "description": "Evidence ledger" } }
      }
    },
    "/ai-profile.json": {
      "get": {
        "summary": "Get a compact AI-readable profile",
        "responses": { "200": { "description": "Compact profile" } }
      }
    },
    "/resume.json": {
      "get": {
        "summary": "Get JSON Resume-compatible basics",
        "responses": { "200": { "description": "JSON Resume-compatible profile" } }
      }
    },
    "/.well-known/human-api.json": {
      "get": {
        "summary": "Discover Human API resources",
        "description": "Experimental, unregistered discovery convention.",
        "responses": { "200": { "description": "Discovery metadata" } }
      }
    },
    "/profile.html": {
      "get": {
        "summary": "Get the crawlable English profile",
        "responses": { "200": { "description": "Human-readable static profile" } }
      }
    },
    "/llms.txt": {
      "get": {
        "summary": "Get the experimental LLM context index",
        "responses": { "200": { "description": "Plain-text context index" } }
      }
    }
  }
}
